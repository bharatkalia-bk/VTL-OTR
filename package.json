{
  "name": "vtl-otr",
  "private": true,
  "version": "1.0.0",
  "description": "VTL One Time Registration Platform. A product of Vensysco Technologies Limited.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "build:shared": "pnpm --filter @vtl/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel --filter ./apps/** run dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck",
    "test": "pnpm build:shared && pnpm -r run test",
    "test:e2e": "pnpm --filter @vtl/candidate-web e2e",
    "db:migrate": "pnpm --filter @vtl/api prisma:migrate",
    "db:seed": "pnpm --filter @vtl/api seed",
    "brand:assets": "node scripts/brand-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "sharp", "esbuild", "@swc/core", "@napi-rs/canvas"]
  }
}
