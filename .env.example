# ── VTL OTR configuration (copy to apps/api/.env; docker-compose reads ./.env) ──
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
CANDIDATE_WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://vtl:vtl@localhost:5432/vtl_otr?schema=public
REDIS_URL=redis://localhost:6379

# Secrets. Docker (docker compose): leave these empty and the local stack uses built-in dev-only values.
# Running the API directly (apps/api/.env): fill each one with the output of `openssl rand -base64 32`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PII_ENC_KEY=
PII_INDEX_KEY=
FILE_URL_SECRET=
COOKIE_SECURE=false

# Storage: fs (local folder) or s3 (MinIO / S3, private bucket + pre-signed URLs)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./.storage
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_BUCKET=vtl-otr
# S3_ACCESS_KEY=vtl-minio
# S3_SECRET_KEY=vtl-minio-secret

# Integrations (mock adapters by default; real adapters plug in behind the same interfaces)
EMAIL_DRIVER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
PAYMENT_WEBHOOK_SECRET=mock-gateway-webhook-secret

# Dev conveniences (must be false in production; enforced at boot)
DEV_EXPOSE_SECRETS=true
RUN_WORKER_IN_API=true
SWAGGER_ENABLED=true
LOG_LEVEL=info

# AI assist: mock (default, no network) or claude (needs ANTHROPIC_API_KEY; model AI_MODEL)
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
