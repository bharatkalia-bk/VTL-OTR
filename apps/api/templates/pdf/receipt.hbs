{{> header title="Payment Receipt" subtitle="भुगतान रसीद"}}
<div class="idbox">
  <div><div class="label">Amount paid</div><div class="value num">Rs {{amount}}</div></div>
  <div style="text-align:right"><span class="badge {{tone}}" style="font-size:11pt">{{status}}</span></div>
</div>
<div class="band">Transaction</div>
<div class="box"><table class="kv">
  <tr><td class="k">Merchant transaction ID</td><td class="v num">{{merchantTxnId}}</td></tr>
  <tr><td class="k">Gateway reference</td><td class="v num">{{gatewayTxnId}}</td></tr>
  <tr><td class="k">Gateway</td><td class="v">{{gateway}}</td></tr>
  <tr><td class="k">Date & time</td><td class="v num">{{paidAt}}</td></tr>
</table></div>
<div class="band">Application</div>
<div class="box"><table class="kv">
  <tr><td class="k">Examination</td><td class="v">{{exam}}</td></tr>
  <tr><td class="k">Application No.</td><td class="v num">{{applicationNo}}</td></tr>
  <tr><td class="k">OTR ID</td><td class="v num">{{otrId}}</td></tr>
  <tr><td class="k">Candidate</td><td class="v">{{name}}</td></tr>
</table></div>
<p class="muted" style="margin-top:10px">This is a computer-generated receipt and does not require a signature. Fees once paid are not refundable except as per the examination notice.</p>
{{> footer}}
